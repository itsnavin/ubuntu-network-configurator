{
  "name": "ubuntu-network-configurator",
  "private": true,
  "version": "1.0.0",
  "description": "Guided, offline Ubuntu Netplan YAML generator for DHCP, static IP and advanced networking (bridges, bonds, VLANs, Wi-Fi).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "vitest run tests/fixtures.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
